# Netlify Environment Variables Configuration
# Set these in: Netlify Dashboard -> Site settings -> Environment variables

# URL of your deployed Python FastAPI backend (e.g. on Render, Railway, Fly.io, or VPS)
# Example: https://rawther-biriyani-api.onrender.com
VITE_API_BASE_URL=

# (Optional) WebSocket URL for live kitchen display & order tracking
# Example: wss://rawther-biriyani-api.onrender.com
VITE_WS_URL=
